# Database - Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/library?sslmode=require

# Google Gemini AI
# Verify these model names in Google AI Studio. They are configurable because
# Gemini model availability changes. gemini-2.5-flash is retired for new keys.
# gemini-embedding-001 is requested at EMBEDDING_DIMENSIONS (768).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Auth.js / NextAuth
AUTH_SECRET=your_random_secret_here_min_32_chars
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Optional RAG controls
SIMILARITY_THRESHOLD=0.55
POLICY_SIMILARITY_THRESHOLD=0.4
SEMANTIC_RESULT_LIMIT=5

# Set to true only when you intentionally want to wipe and reseed a production database
SEED_ALLOW_PRODUCTION=false

# Embedding dimensions. gemini-embedding-001 is requested at this size.
EMBEDDING_DIMENSIONS=768

# Library Settings (defaults, also configurable in DB)
DEFAULT_MAX_LOANS=3
DEFAULT_LOAN_DURATION_DAYS=14
DEFAULT_FINE_PER_DAY=5
